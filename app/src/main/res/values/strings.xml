    <!-- Tutorial -->
    <string name="how_to_play">How to play</string>
    <string name="tutorial_step_of">Step %1$d of %2$d</string>
    <string name="tutorial_title_1">The board</string>
    <string name="tutorial_body_1">Bagh Chal is played on a 5×5 board. Pieces sit on the crossings of the lines — not inside the squares.</string>
    <string name="tutorial_title_2">Tigers &amp; Goats</string>
    <string name="tutorial_body_2">4 Tigers start on the corners. 20 Goats start off the board. Goats place first, one by one.</string>
    <string name="tutorial_title_3">Phase 1 — Place goats</string>
    <string name="tutorial_body_3">Each goat turn: place one goat on an empty point. Tigers can move or jump to catch goats even during this phase.</string>
    <string name="tutorial_title_4">How tigers catch</string>
    <string name="tutorial_body_4">A tiger jumps over an adjacent goat into the empty point beyond — like checkers. One goat per jump. Catch 5 goats to win.</string>
    <string name="tutorial_title_5">How goats win</string>
    <string name="tutorial_body_5">After all goats are placed, both sides move. Goats win by blocking every tiger so none can move. Watch the trays: goats left to place, and 5 tiger catch slots.</string>

    <!-- Privacy -->
    <string name="privacy_updated">Bagh Chal — Tigers &amp; Goats · Last updated: September 2026</string>
    <string name="privacy_overview_title">Overview</string>
    <string name="privacy_overview_body">Bagh Chal — Tigers &amp; Goats is an offline board game. The core game (2 Players Offline and Play vs AI) works without an internet connection and without creating an account.</string>
    <string name="privacy_collect_title">Data we collect</string>
    <string name="privacy_collect_body">In the current version, the app does not require login and does not intentionally collect personal information such as name, email, or phone number for gameplay.</string>
    <string name="privacy_stored_title">Data stored on your device</string>
    <string name="privacy_stored_body">The app may store simple preferences on your device (for example language, whether you have finished the tutorial, and gameplay settings such as move hints). This data stays on your phone and is not uploaded by us.</string>
    <string name="privacy_ads_title">Ads, analytics, and purchases</string>
    <string name="privacy_ads_body">This version does not include advertising SDKs, analytics SDKs, or in-app purchases. If we add them in a future update, this policy will be updated and the Play Store listing will describe any new data use.</string>
    <string name="privacy_children_title">Children</string>
    <string name="privacy_children_body">Bagh Chal is a strategy board game suitable for a general audience. We do not knowingly collect personal data from children.</string>
    <string name="privacy_changes_title">Changes</string>
    <string name="privacy_changes_body">We may update this privacy policy when the app changes. The “Last updated” date at the top will change when we do.</string>
    <string name="privacy_contact_title">Contact</string>
    <string name="privacy_contact_body">Questions about privacy: contact the developer through the Google Play Store listing for Bagh Chal — Tigers &amp; Goats, or open an issue on the project repository if you use GitHub.</string>

