    <string name="how_to_play">कैसे खेलें</string>
    <string name="tutorial_step_of">चरण %1$d / %2$d</string>
    <string name="tutorial_title_1">बोर्ड</string>
    <string name="tutorial_body_1">बाघ चाल 5×5 बोर्ड पर खेला जाता है। मोहरे रेखाओं के चौराहों पर बैठते हैं — वर्गों के अंदर नहीं।</string>
    <string name="tutorial_title_2">बाघ और बकरियाँ</string>
    <string name="tutorial_body_2">4 बाघ कोनों पर शुरू होते हैं। 20 बकरियाँ बोर्ड से बाहर शुरू होती हैं। बकरियाँ पहले एक-एक करके रखी जाती हैं।</string>
    <string name="tutorial_title_3">चरण 1 — बकरियाँ रखें</string>
    <string name="tutorial_body_3">हर बकरी की बारी: खाली बिंदु पर एक बकरी रखें। इस चरण में भी बाघ चल सकते हैं या कूदकर बकरी पकड़ सकते हैं।</string>
    <string name="tutorial_title_4">बाघ कैसे पकड़ते हैं</string>
    <string name="tutorial_body_4">बाघ पास की बकरी के ऊपर से खाली बिंदु पर कूदता है — जैसे चेकर्स। एक छलांग में एक बकरी। 5 बकरियाँ पकड़ने पर जीत।</string>
    <string name="tutorial_title_5">बकरियाँ कैसे जीतती हैं</string>
    <string name="tutorial_body_5">सभी बकरियाँ रखने के बाद दोनों पक्ष चलते हैं। बकरियाँ हर बाघ को रोककर जीतती हैं ताकि कोई न चल सके। ट्रे देखें: रखने वाली बकरियाँ और बाघ के 5 पकड़ स्लॉट।</string>

    <string name="privacy_updated">बाघ चाल — बाघ और बकरियाँ · अंतिम अपडेट: सितंबर 2026</string>
    <string name="privacy_overview_title">सारांश</string>
    <string name="privacy_overview_body">बाघ चाल — बाघ और बकरियाँ एक ऑफ़लाइन बोर्ड गेम है। मुख्य खेल (2 खिलाड़ी ऑफ़लाइन और AI से खेल) इंटरनेट और खाते के बिना चलता है।</string>
    <string name="privacy_collect_title">हम कौन सा डेटा एकत्र करते हैं</string>
    <string name="privacy_collect_body">वर्तमान संस्करण में लॉगिन की आवश्यकता नहीं है और गेमप्ले के लिए नाम, ईमेल या फ़ोन जैसे व्यक्तिगत डेटा जानबूझकर एकत्र नहीं किए जाते।</string>
    <string name="privacy_stored_title">आपके डिवाइस पर संग्रहीत डेटा</string>
    <string name="privacy_stored_body">ऐप आपके डिवाइस पर सरल प्राथमिकताएँ संग्रहीत कर सकता है (जैसे भाषा, ट्यूटोरियल पूरा होना, और चाल संकेत जैसी सेटिंग्स)। यह डेटा आपके फ़ोन पर रहता है और हम अपलोड नहीं करते।</string>
    <string name="privacy_ads_title">विज्ञापन, विश्लेषण और खरीदारी</string>
    <string name="privacy_ads_body">इस संस्करण में विज्ञापन, विश्लेषण SDK या इन-ऐप खरीदारी नहीं है। भविष्य में जोड़ने पर यह नीति और Play Store लिस्टिंग अपडेट होगी।</string>
    <string name="privacy_children_title">बच्चे</string>
    <string name="privacy_children_body">बाघ चाल सामान्य दर्शकों के लिए उपयुक्त रणनीति बोर्ड गेम है। हम जानबूझकर बच्चों से व्यक्तिगत डेटा नहीं लेते।</string>
    <string name="privacy_changes_title">परिवर्तन</string>
    <string name="privacy_changes_body">ऐप बदलने पर हम यह नीति अपडेट कर सकते हैं। ऊपर की “अंतिम अपडेट” तारीख तब बदलेगी।</string>
    <string name="privacy_contact_title">संपर्क</string>
    <string name="privacy_contact_body">गोपनीयता संबंधी प्रश्न: बाघ चाल — बाघ और बकरियाँ की Google Play Store लिस्टिंग के माध्यम से डेवलपर से संपर्क करें, या GitHub पर issue खोलें।</string>

