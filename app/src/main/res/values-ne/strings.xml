    <string name="tutorial_step_of">चरण %1$d / %2$d</string>
    <string name="tutorial_title_1">बोर्ड</string>
    <string name="tutorial_body_1">बाघ चाल ५×५ बोर्डमा खेलिन्छ। गोटा रेखाका चौराहमा बस्छन् — वर्गभित्र होइन।</string>
    <string name="tutorial_title_2">बाघ र बाख्रा</string>
    <string name="tutorial_body_2">४ बाघ कुनामा सुरु हुन्छन्। २० बाख्रा बोर्डबाहिर सुरु हुन्छन्। बाख्रा पहिले एक-एक गरी राखिन्छन्।</string>
    <string name="tutorial_title_3">चरण १ — बाख्रा राख्नुहोस्</string>
    <string name="tutorial_body_3">प्रत्येक बाख्राको पालो: खाली बिन्दुमा एक बाख्रा राख्नुहोस्। यस चरणमा पनि बाघ चल्न वा उफ्रेर बाख्रा समात्न सक्छन्।</string>
    <string name="tutorial_title_4">बाघले कसरी समात्छ</string>
    <string name="tutorial_body_4">बाघ नजिकको बाख्रा माथि उफ्रेर खाली बिन्दुमा जान्छ — चेकर्स जस्तै। एक उफ्राइमा एक बाख्रा। ५ बाख्रा समाते जीत।</string>
    <string name="tutorial_title_5">बाख्राले कसरी जित्छ</string>
    <string name="tutorial_body_5">सबै बाख्रा राखेपछि दुवै पक्ष चल्छन्। बाख्राले हरेक बाघलाई रोकेर जित्छन् ताकि कोही नचल्न सकोस्। ट्रे हेर्नुहोस्: राख्न बाँकी बाख्रा र बाघका ५ समात्ने स्लट।</string>

    <string name="privacy_updated">बाघ चाल — बाघ र बाख्रा · अन्तिम अपडेट: सेप्टेम्बर २०२६</string>
    <string name="privacy_overview_title">सारांश</string>
    <string name="privacy_overview_body">बाघ चाल — बाघ र बाख्रा अफलाइन बोर्ड खेल हो। मुख्य खेल (२ खेलाडी अफलाइन र AI सँग) इन्टरनेट र खाता बिना चल्छ।</string>
    <string name="privacy_collect_title">हामी कुन डेटा संकलन गर्छौं</string>
    <string name="privacy_collect_body">हालको संस्करणमा लगइन चाहिँदैन र गेमप्लेका लागि नाम, इमेल वा फोन जस्ता व्यक्तिगत डेटा जानाजानी संकलन गरिँदैन।</string>
    <string name="privacy_stored_title">तपाईंको यन्त्रमा बचत हुने डेटा</string>
    <string name="privacy_stored_body">एपले यन्त्रमा सरल प्राथमिकता बचत गर्न सक्छ (जस्तै भाषा, ट्यूटोरियल पूरा भएको, र चाल संकेत जस्ता सेटिङ)। यो डेटा फोनमै रहन्छ र हामी अपलोड गर्दैनौं।</string>
    <string name="privacy_ads_title">विज्ञापन, विश्लेषण र खरिद</string>
    <string name="privacy_ads_body">यस संस्करणमा विज्ञापन, विश्लेषण SDK वा इन-एप खरिद छैन। भविष्यमा थपे यो नीति र Play Store लिस्टिङ अपडेट हुनेछ।</string>
    <string name="privacy_children_title">बालबालिका</string>
    <string name="privacy_children_body">बाघ चाल सामान्य दर्शकका लागि उपयुक्त रणनीति बोर्ड खेल हो। हामी जानाजानी बालबालिकाबाट व्यक्तिगत डेटा लिँदैनौं।</string>
    <string name="privacy_changes_title">परिवर्तन</string>
    <string name="privacy_changes_body">एप परिवर्तन हुँदा हामी यो नीति अपडेट गर्न सक्छौं। माथिको “अन्तिम अपडेट” मिति त्यसबेला परिवर्तन हुन्छ।</string>
    <string name="privacy_contact_title">सम्पर्क</string>
    <string name="privacy_contact_body">गोपनीयताबारे प्रश्न: बाघ चाल — बाघ र बाख्राको Google Play Store लिस्टिङमार्फत विकासकर्तारसँग सम्पर्क गर्नुहोस्, वा GitHub मा issue खोल्नुहोस्।</string>

